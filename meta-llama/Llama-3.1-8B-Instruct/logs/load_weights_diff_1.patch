+                ttnn.DataType.BFLOAT16,
+                device,
+                ttnn.MemoryConfig(
+                    ttnn.TensorMemoryLayout.INTERLEAVED, ttnn.BufferType.DRAM, None
+                ),
+            )
+        else:
+            weights[key] = utils.load_tensor(
+                file_path,
+                ttnn.Layout.ROW_MAJOR,
+                ttnn.DataType.BFLOAT16,
+                None,
+                None,
+            )
+    return weights
